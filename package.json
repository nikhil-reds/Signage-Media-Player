{
  "name": "signlink-digital-signage-player",
  "version": "1.0.0",
  "description": "Unattended cross-platform digital signage player",
  "desktopName": "reds-player.desktop",
  "main": "electron/main.cjs",
  "author": "SignLink",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "validate:brightsign": "node scripts/validate-brightsign.mjs",
    "build:windows": "electron-builder --win nsis --x64 --config.directories.output=output/windows",
    "build:brightsign": "node scripts/package-brightsign.mjs",
    "build:linux": "node scripts/preflight-linux-build.mjs && electron-builder --linux AppImage --x64 --arm64 --config.directories.output=output/linux",
    "build:mac": "electron-builder --mac dmg --universal --config.directories.output=output/macos",
    "publish:player-build": "node scripts/publish-player-build.mjs",
    "build:linux:docker": "node scripts/build-linux-docker.mjs"
  },
  "build": {
    "appId": "io.signlink.player",
    "productName": "reds-player",
    "asar": true,
    "icon": "assets/logo.png",
    "files": [
      "electron/**/*",
      "index.html",
      "app.js",
      "styles.css",
      "config.json",
      "manifest.json",
      "assets/**/*",
      "media/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "reds-player.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null,
      "artifactName": "reds-player.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "artifactName": "reds-player-${arch}.${ext}",
      "syncDesktopName": true,
      "synopsis": "REDS digital signage player"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/lib-storage": "^3.1081.0",
    "archiver": "^8.0.0",
    "brighterscript": "^0.73.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
